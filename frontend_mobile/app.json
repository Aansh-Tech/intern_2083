{
  "expo": {
    "name": "MyFolio",
    "slug": "MyFolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/myfolio-logo.png",
    "scheme": "frontendmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/myfolio-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171B1C",
        "foregroundImage": "./assets/images/myfolio-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04091C",
          "image": "./assets/images/myfolio-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "expo": {
      "web": {
        "bundler": "metro"
      }
    },
    "extra": {
      "API_BASE_URL": "process.env.API_BASE_URL"
    }
  }
}
